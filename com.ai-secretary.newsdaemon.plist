<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- LaunchAgent 識別子 -->
    <key>Label</key>
    <string>com.ai-secretary.newsdaemon</string>

    <!--
        ProgramArguments: 絶対パスで指定してください。
        - python3 のパス: which python3 で確認
        - news_daemon.py のパス: このリポジトリをクローンした場所に合わせて変更
        例: /Users/sy817/sy817.github.io/news_daemon.py
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/YOUR_USERNAME/Desktop/ai-secretary/news_daemon.py</string>
    </array>

    <!-- Mac 起動時に自動起動 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- プロセスが終了した場合に再起動 -->
    <key>KeepAlive</key>
    <true/>

    <!-- 標準出力・エラーのログファイル -->
    <key>StandardOutPath</key>
    <string>/tmp/news_daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/news_daemon_error.log</string>

    <!--
        環境変数:
        実際のキーをここに入力するか、
        ~/.zshrc 等でエクスポートしている場合は EnvironmentVariables ブロックごと削除可。
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>ANTHROPIC_API_KEY</key>
        <string>YOUR_ANTHROPIC_API_KEY_HERE</string>
        <key>CHATWORK_API_TOKEN</key>
        <string>YOUR_CHATWORK_API_TOKEN_HERE</string>
    </dict>
</dict>
</plist>
